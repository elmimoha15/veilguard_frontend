# Polar hosted checkout links for Veilguard Pro.
# Copy this file to `.env.local` and replace the placeholders with the real
# Polar checkout URLs. NEXT_PUBLIC_ vars are inlined into the browser bundle at
# build time — rebuild (or restart `next dev`) after changing them.
NEXT_PUBLIC_POLAR_CHECKOUT_URL=https://sandbox.polar.sh/checkout/PLACEHOLDER
NEXT_PUBLIC_POLAR_YEARLY_CHECKOUT_URL=https://sandbox.polar.sh/checkout/PLACEHOLDER_YEARLY

# Google Search Console — HTML-tag verification token. In GSC: Add property →
# URL prefix → https://veilguard.dev → "HTML tag" → copy the content="..." value
# (just the token, not the whole tag). Set it here, rebuild, and deploy.
GOOGLE_SITE_VERIFICATION=

# ── Firebase (client web config) ─────────────────────────────────────────────
# Copy to .env.local and paste your project's web config. Get it from:
#   Firebase console → Project settings → General → "Your apps" → Web app → SDK
#   setup and configuration → "Config".  (Or run in the backend/frontend repo:
#   firebase apps:sdkconfig WEB --project <projectId>)
# NEXT_PUBLIC_ vars are inlined into the browser bundle at build time — restart
# `next dev` after changing them. The web apiKey is a PUBLIC identifier, not a
# secret: access is governed by Auth providers + Firestore rules.
#
# Set USE_EMULATOR=true only for local emulator runs; false = the real project.
NEXT_PUBLIC_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Emulator-only hosts (ignored when USE_EMULATOR=false).
NEXT_PUBLIC_FIRESTORE_EMULATOR=localhost:8080
NEXT_PUBLIC_AUTH_EMULATOR=http://localhost:9099

# The backend dev-server (createScan / connect / deep scan / dev unlock).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# DEV-ONLY: preview the unlocked-fix UI before real billing. Must stay false in
# production (the backend also refuses unless DEV_FAKE_PAID=1 AND on emulator).
NEXT_PUBLIC_DEV_FAKE_PAID=false
