# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# firebase
.firebase/
firebase-debug.log
*.cache

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed reference template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Veilguard — local IDE setup (generated by `veilguard init`, not committed)
.veilguard/

# Local agent tooling — installed skills & generated design system (not site code)
.claude/
.agents/
design-system/
skills-lock.json

# Installed design-skill tooling
.claude/skills/
.agents/
